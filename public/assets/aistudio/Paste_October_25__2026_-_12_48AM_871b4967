    }

    for (var i = 0; i < chests.length; i++) {
      var ch = chests[i]; ctx.fillStyle = ch.opened ? '#5e4327' : '#9c6631'; ctx.fillRect(ch.x + 4, ch.y + 10, 20, 18); ctx.strokeStyle = '#ffd700'; ctx.strokeRect(ch.x + 4, ch.y + 10, 20, 18);
    }

    var bob = Math.sin(Date.now() * 0.005) * 2.5;
    for (var ci = 0; ci < coins.length; ci++) {
      var cObj = coins[ci];
      if (!cObj.collected) {
        if (cObj.kind === 'coin') { ctx.fillStyle = '#ffd700'; ctx.beginPath(); ctx.arc(cObj.x + 8, cObj.y + 8 + bob, 6.5, 0, Math.PI * 2); ctx.fill(); }
        else { ctx.fillStyle = '#2bf56b'; ctx.beginPath(); ctx.moveTo(cObj.x + 8, cObj.y + bob); ctx.lineTo(cObj.x + 15, cObj.y + 8 + bob); ctx.lineTo(cObj.x + 8, cObj.y + 16 + bob); ctx.lineTo(cObj.x + 1, cObj.y + 8 + bob); ctx.fill(); }
      }
    }

    for (var pi = 0; pi < portals.length; pi++) {
      var pt = portals[pi];
      if (!pt.gemTaken) { ctx.fillStyle = '#00ffea'; ctx.beginPath(); ctx.moveTo(pt.gemX + 10, pt.gemY + bob); ctx.lineTo(pt.gemX + 20, pt.gemY + 11 + bob); ctx.lineTo(pt.gemX + 10, pt.gemY + 22 + bob); ctx.lineTo(pt.gemX, pt.gemY + 11 + bob); ctx.fill(); }
    }

    for (var gi = 0; gi < ghosts.length; gi++) {
      var ghObj = ghosts[gi]; if (ghObj.hp <= 0) continue;
      var gy = ghObj.y + Math.sin(ghObj.bob) * 4;
      ctx.save(); ctx.translate(ghObj.x + 14, gy + 14); ctx.scale(ghObj.dir, 1);
      ctx.fillStyle = 'rgba(110, 235, 255, 0.88)'; ctx.beginPath(); ctx.arc(0, -3, 11, Math.PI, 0, false); ctx.lineTo(11, 11); ctx.lineTo(5, 7); ctx.lineTo(0, 11); ctx.lineTo(-5, 7); ctx.lineTo(-11, 11); ctx.closePath(); ctx.fill();
      ctx.fillStyle = '#ffea00'; ctx.fillRect(2, -5, 3, 3); ctx.fillRect(-5, -5, 3, 3);
      ctx.restore();
    }

    var pOx = player.x + player.w / 2;
    var pOy = player.y + player.h / 2 - 2;

    if (aiEnabled && ep.lidarRays) {
      ctx.save();
      ctx.lineWidth = 1.2;
      ctx.setLineDash([3, 3]);
      for (var lr = 0; lr < ep.lidarRays.length; lr++) {
        var ray = ep.lidarRays[lr];
        ctx.strokeStyle = ray.hazard ? 'rgba(255, 82, 99, 0.75)' : 'rgba(78, 237, 132, 0.45)';
        ctx.beginPath();
        ctx.moveTo(pOx, pOy);
        ctx.lineTo(ray.x2, ray.y2);
        ctx.stroke();
      }
      ctx.restore();
    }

    if (rlBrain.maxDistMeters > 0) {
      var recordPx = ep.startX + rlBrain.maxDistMeters * 12;
      ctx.save();
      ctx.strokeStyle = '#ffd700'; ctx.lineWidth = 2; ctx.setLineDash([6, 4]);
      ctx.beginPath(); ctx.moveTo(recordPx, 28); ctx.lineTo(recordPx, 13 * TILE); ctx.stroke();
      ctx.fillStyle = '#ffd700'; ctx.font = 'bold 10px "Courier New", monospace';
      ctx.fillText('RECORD MAX-X: ' + rlBrain.maxDistMeters + 'm', recordPx - 55, 42);
      ctx.restore();
    }

    var aimAngle = aiEnabled ? ep.aimAngle : Math.atan2(mouse.worldY - pOy, mouse.worldX - pOx);
    ctx.save(); ctx.translate(pOx, player.y + player.h / 2); var face = Math.cos(aimAngle) >= 0 ? 1 : -1; ctx.scale(face, 1);
    ctx.fillStyle = player.weapon === 'crimson' ? '#7a2336' : '#28427a'; ctx.fillRect(-7, -3, 14, 15);
    ctx.fillStyle = player.weapon === 'crimson' ? '#ab324b' : '#3b5fa8'; ctx.fillRect(-6, -12, 12, 10);
    ctx.fillStyle = '#55f2ff'; ctx.fillRect(2, -8, 2, 2); ctx.restore();

    ctx.save(); ctx.translate(pOx, pOy); ctx.rotate(aimAngle); ctx.fillStyle = '#8b5a2b'; ctx.fillRect(2, -1.5, 16, 3); ctx.fillStyle = '#3df7ff'; ctx.beginPath(); ctx.arc(19, 0, 3.5, 0, Math.PI * 2); ctx.fill(); ctx.restore();

    for (var si = 0; si < spells.length; si++) {
      var sp = spells[si]; ctx.fillStyle = sp.type === 'flame' ? '#ff6622' : '#3df7ff'; ctx.beginPath(); ctx.arc(sp.x, sp.y, 5, 0, Math.PI * 2); ctx.fill();
    }
    ctx.restore();

    ctx.fillStyle = 'rgba(10, 12, 20, 0.92)'; ctx.fillRect(10, 10, 425, 72); ctx.strokeStyle = '#2d3552'; ctx.strokeRect(10, 10, 425, 72);
    ctx.fillStyle = '#00ffea'; ctx.font = 'bold 11.5px "Courier New", monospace';
    ctx.fillText('EP #' + rlBrain.attempt + ' | X: ' + getDistanceMeters() + 'm (MAX: ' + rlBrain.maxDistMeters + 'm)', 16, 26);
    ctx.fillStyle = '#ffd700'; ctx.fillText('STAGE ' + rlBrain.activeStageText + ' | LIDAR: ' + rlBrain.activeContextText, 16, 42);

    for (var hi = 0; hi < player.maxHp; hi++) { var ox = 18 + hi * 20, oy = 50; ctx.fillStyle = hi < player.hp ? '#e62e49' : '#2e222b'; ctx.beginPath(); ctx.arc(ox + 6, oy + 6, 6, 0, Math.PI * 2); ctx.fill(); }
    ctx.fillStyle = '#4eed84'; ctx.fillText('CLEARS: ' + ep.hazardsCleared + ' | THREATS: ' + ep.ghostKills, 130, 60);
  }

  function updateAIPanelUI() {
    if (!player || !ep) return;
    safeSetText('ui-gen', '#' + rlBrain.attempt);
    safeSetText('ui-stage', rlBrain.activeStageText);
    safeSetText('ui-mode', rlBrain.activeContextText);
    var vVal = safeNum(rlBrain.lastCriticVal, 0);
    safeSetText('ui-seed', (vVal >= 0 ? '+' : '') + vVal.toFixed(1));
    safeSetText('ui-best', (rlBrain.bestReward !== null ? rlBrain.bestReward : 0).toLocaleString());
    safeSetText('ui-max-dist', rlBrain.maxDistMeters + 'm (Sec ' + rlBrain.maxSector + ')');
    safeSetText('ui-sps', displayedSPS.toLocaleString());

    for (var a = 0; a < NUM_ACTIONS; a++) {
      var pPct = (safeNum(rlBrain.lastProbs[a], 0.167) * 100).toFixed(1) + '%';
      var advVal = safeNum(rlBrain.lastAdv[a], 0);
      var advStr = (advVal >= 0 ? '+' : '') + advVal.toFixed(1);
      var el = document.getElementById('ui-w' + a);
      if (el) {
        el.textContent = pPct + ' (A:' + advStr + ')';
        el.className = 'stat-val ' + (a === ep.currentAction ? 'pos' : (advVal < -1.0 ? 'neg' : ''));
      }
    }

    var liveHpBonus = player.hp * 1000 + ep.heartsKeptBonus;
    safeSetText('ui-r-dist', (ep.distReward >= 0 ? '+' : '') + Math.round(ep.distReward).toLocaleString());
    safeSetText('ui-r-evade', '+' + ep.evadeReward.toLocaleString() + ' (' + ep.hazardsCleared + ')');
    safeSetText('ui-r-sec', '+' + ep.sectorReward.toLocaleString() + ' (' + ep.sectorsCleared + ')');
    safeSetText('ui-r-ghost', '+' + ep.ghostReward.toLocaleString() + ' (' + ep.ghostKills + ')');
    safeSetText('ui-r-coin', '+' + ep.coinReward.toLocaleString() + ' (' + ep.coinsCollected + ')');
    safeSetText('ui-r-hp', '+' + liveHpBonus.toLocaleString() + ' (' + player.hp + ')');
    safeSetText('ui-r-bul', '-' + ep.bulletPenalty.toLocaleString() + ' (' + ep.bulletsFired + ')');
    safeSetText('ui-r-dmg', '-' + (ep.damagePenalty + ep.loopPenalty).toLocaleString() + ' (' + ep.heartsLost + ')');
    safeSetText('ui-r-total', getNetReward().toLocaleString());

    var histArr = Array.isArray(rlBrain.fullHistory) ? rlBrain.fullHistory : [];
    var recent = histArr.slice(-15).reverse();
    var listEl = document.getElementById('history-list');
    if (listEl) {
      var htmlRows = [];
      for (var rIdx = 0; rIdx < recent.length; rIdx++) {
        var h = recent[rIdx];
        htmlRows.push('<div><span class="gold">#' + h.attempt + '</span>: <span class="cyan">X:' + h.dist + 'm</span> (Max:' + (h.recordDist || h.dist) + 'm) | Clr:' + (h.evades || 0) + ' | ' + h.cause + '</div>');
      }
      listEl.innerHTML = htmlRows.join('');
    }

    var chart = document.getElementById('chart-canvas');
    if (!chart) return;
    var cctx = chart.getContext('2d');
    cctx.clearRect(0, 0, chart.width, chart.height);

    if (histArr.length > 1) {
      var maxD = 25;
      for (var mi = 0; mi < histArr.length; mi++) {
        var dVal = histArr[mi].recordDist || histArr[mi].dist || 0;
        if (dVal > maxD) maxD = dVal;
      }
      var padL = 24, padR = 6, padT = 6, padB = 12;
      var gw = chart.width - padL - padR, gh = chart.height - padT - padB;

      cctx.fillStyle = '#7a88a8'; cctx.font = '8px "Courier New", monospace';
      cctx.fillText(Math.round(maxD) + 'm', 2, padT + 6); cctx.fillText('0m', 4, padT + gh);
      cctx.fillText('#1', padL, chart.height - 2); cctx.fillText('#' + histArr[histArr.length - 1].attempt, chart.width - 28, chart.height - 2);

      cctx.strokeStyle = 'rgba(0, 255, 234, 0.55)'; cctx.lineWidth = 1.2; cctx.beginPath();
      for (var i1 = 0; i1 < histArr.length; i1++) {
        var cx1 = padL + (i1 / (histArr.length - 1)) * gw; var cy1 = padT + gh - (histArr[i1].dist / maxD) * gh;
        if (i1 === 0) cctx.moveTo(cx1, cy1); else cctx.lineTo(cx1, cy1);
      }
      cctx.stroke();

      cctx.strokeStyle = '#4eed84'; cctx.lineWidth = 1.6; cctx.beginPath();
      var sumWindow = 0, winSize = 10;
      for (var i2 = 0; i2 < histArr.length; i2++) {
        sumWindow += histArr[i2].dist;
        if (i2 >= winSize) sumWindow -= histArr[i2 - winSize].dist;
        var avgX = sumWindow / Math.min(i2 + 1, winSize);
        var cx2 = padL + (i2 / (histArr.length - 1)) * gw; var cy2 = padT + gh - (avgX / maxD) * gh;
        if (i2 === 0) cctx.moveTo(cx2, cy2); else cctx.lineTo(cx2, cy2);
      }
      cctx.stroke();

      cctx.strokeStyle = '#ffd700'; cctx.lineWidth = 1.8; cctx.beginPath();
      var runningMax = 0;
      for (var i3 = 0; i3 < histArr.length; i3++) {
        if (histArr[i3].dist > runningMax) runningMax = histArr[i3].dist;
        var cx3 = padL + (i3 / (histArr.length - 1)) * gw; var cy3 = padT + gh - (runningMax / maxD) * gh;
        if (i3 === 0) cctx.moveTo(cx3, cy3); else cctx.lineTo(cx3, cy3);
      }
      cctx.stroke();
    }
  }

  // ===========================================================================
  // 9. BUTTON LISTENERS & EXPORTERS
  // ===========================================================================
  window.toggleAI = function() {
    aiEnabled = !aiEnabled;
    var b = document.getElementById('btn-ai');
    if (b) {
      b.textContent = aiEnabled ? '[B] PPO-GAE Robot Brain: ON' : '[B] Manual Teleop (Training!)';
      b.classList.toggle('active', aiEnabled);
    }
  };

  window.togglePause = function() {
    isPaused = !isPaused;
    var b = document.getElementById('btn-pause');
    if (b) {
      b.textContent = isPaused ? '[P] RESUME TEST' : '[P] Pause / Stop';
      b.classList.toggle('active', isPaused);
    }
    setStatus(isPaused ? 'PAUSED' : 'RUNNING', false);
    if (isPaused) updateAIPanelUI();
  };

  bindClickSafe('btn-ai', window.toggleAI);
  bindClickSafe('btn-pause', window.togglePause);
  bindClickSafe('btn-wipe', wipeBrain);

  var spdBtns = document.querySelectorAll('[data-spd]');
  for (var bIdx = 0; bIdx < spdBtns.length; bIdx++) {
    spdBtns[bIdx].addEventListener('click', function() {
      this.blur();
      targetSimSpeed = Math.max(1, Math.min(100000, Number(this.getAttribute('data-spd')) || 1));
      safeSetText('speed-label', targetSimSpeed.toLocaleString() + 'x');
      for (var i = 0; i < spdBtns.length; i++) {
        spdBtns[i].classList.toggle('active', targetSimSpeed === Number(spdBtns[i].getAttribute('data-spd')));
      }
    });
  }

  function triggerDownload(url, filename) {
    var a = document.createElement('a'); a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  }

  bindClickSafe('btn-dl-png', function() {
    var expCanvas = document.createElement('canvas'); expCanvas.width = 1280; expCanvas.height = 700;
    var ectx = expCanvas.getContext('2d');
    ectx.fillStyle = '#070910'; ectx.fillRect(0, 0, 1280, 700);
    ectx.fillStyle = '#ffd700'; ectx.font = 'bold 22px "Courier New", monospace';
    ectx.fillText('SHIPIUS MAGOS 5-STAGE CURRICULUM LAB: MAX X (m) VS. EPISODES', 50, 42);
    ectx.fillStyle = '#00ffea'; ectx.font = '15px "Courier New", monospace';
    ectx.fillText('Episodes: ' + rlBrain.fullHistory.length + ' | Record Max X: ' + rlBrain.maxDistMeters + 'm | Max Score: ' + (rlBrain.bestReward !== null ? rlBrain.bestReward : 0), 50, 72);
    var px = 90, py = 125, pw = 1130, ph = 500;
    ectx.strokeStyle = '#252c44'; ectx.lineWidth = 2; ectx.strokeRect(px, py, pw, ph);

    var hist = rlBrain.fullHistory;
    if (hist.length >= 2) {
      var maxD = 30; for (var m = 0; m < hist.length; m++) if (hist[m].dist > maxD) maxD = hist[m].dist;
      ectx.font = '12px "Courier New", monospace';
      for (var i = 0; i <= 5; i++) {
        var gy = py + (ph * i) / 5; ectx.strokeStyle = '#141929'; ectx.beginPath(); ectx.moveTo(px, gy); ectx.lineTo(px + pw, gy); ectx.stroke();
        ectx.fillStyle = '#8c97b2'; ectx.fillText(((maxD * (5 - i)) / 5).toFixed(1) + 'm', 20, gy + 4);
      }
      ectx.strokeStyle = 'rgba(0, 255, 234, 0.55)'; ectx.lineWidth = 1.8; ectx.beginPath();
      for (var j = 0; j < hist.length; j++) {
        var cx = px + (j / (hist.length - 1)) * pw; var cy = py + ph - (hist[j].dist / maxD) * ph;
        if (j === 0) ectx.moveTo(cx, cy); else ectx.lineTo(cx, cy);
      } ectx.stroke();
      ectx.strokeStyle = '#ffd700'; ectx.lineWidth = 3; ectx.beginPath();
      var bestSoFar = 0;
      for (var k = 0; k < hist.length; k++) {
        if (hist[k].dist > bestSoFar) bestSoFar = hist[k].dist;
        var cxk = px + (k / (hist.length - 1)) * pw; var cyk = py + ph - (bestSoFar / maxD) * ph;
        if (k === 0) ectx.moveTo(cxk, cyk); else ectx.lineTo(cxk, cyk);
      } ectx.stroke();
    }
    triggerDownload(expCanvas.toDataURL('image/png'), 'shipius_curriculum_ppo_gen' + rlBrain.attempt + '.png');
  });

  bindClickSafe('btn-dl-csv', function() {
    var headers = ['Episode,MaxX_Meters,RecordMaxX_Meters,PeakScore,FinalScore,SectorsCleared,ObstaclesCleared,GhostsKilled,CoinsCollected,BulletsFired,HeartsLost,FramesAlive,Cause'];
    var rows = [];
    for (var i = 0; i < rlBrain.fullHistory.length; i++) {
      var h = rlBrain.fullHistory[i];
      rows.push([h.attempt, h.dist, h.recordDist || h.dist, h.peakScore || h.reward, h.reward, h.sectors, h.evades || 0, h.ghosts, h.coins, h.bullets, h.hpLost, h.frames, h.cause].join(','));
    }
    triggerDownload(URL.createObjectURL(new Blob([headers.concat(rows).join('\n')], { type: 'text/csv;charset=utf-8;' })), 'shipius_curriculum_ppo_gen' + rlBrain.attempt + '.csv');
  });

  bindClickSafe('btn-dl-json', function() {
    triggerDownload(URL.createObjectURL(new Blob([JSON.stringify(rlBrain, null, 2)], { type: 'application/json' })), 'shipius_curriculum_ppo_gen' + rlBrain.attempt + '.json');
  });

  bindClickSafe('btn-ul-json', function() {
    var fileInput = document.getElementById('file-input-json');
    if (fileInput) fileInput.click();
  });

  var fIn = document.getElementById('file-input-json');
  if (fIn) {
    fIn.addEventListener('change', function(e) {
      var file = e.target.files[0]; if (!file) return;
      var reader = new FileReader();
      reader.onload = function(evt) {
        try { sanitizeBrain(JSON.parse(evt.target.result)); saveRLBrain(); updateAIPanelUI(); setStatus("LOADED BRAIN #" + rlBrain.attempt, false); } catch (err) { setStatus("INVALID JSON", true); }
      }; reader.readAsText(file);
    });
  }

  // ===========================================================================
  // 10. SELF-RECOVERING MAIN ENGINE LOOP
  // ===========================================================================
  function mainLoop() {
    try {
      var now = Date.now();
      if (now - lastSpsTime >= 1000) {
        displayedSPS = actualStepsThisSec; actualStepsThisSec = 0; lastSpsTime = now;
      }

      if (!isPaused) {
        frameCounter++;
        if (frameCounter % 15 === 1) {
          setStatus('CURRICULUM PPO | FRAME #' + frameCounter + ' (' + displayedSPS.toLocaleString() + ' SPS)', false);
        }
        if (targetSimSpeed <= 20) {
          for (var s = 0; s < targetSimSpeed; s++) stepPhysics();
        } else {
          var deadline = Date.now() + 12;
          var stepsRun = 0;
          while (stepsRun < targetSimSpeed && Date.now() < deadline) {
            for (var b = 0; b < 60 && stepsRun < targetSimSpeed; b++, stepsRun++) stepPhysics();
          }
        }
      }
      renderWorld();
      if (frameCounter % 5 === 0) updateAIPanelUI();
    } catch (err) {
      setStatus('RECOVERED: ' + err.message, true);
      startNewAttempt();
    }
    window.requestAnimationFrame(mainLoop);
  }

  loadRLBrain();
  syncSliders();
  startNewAttempt();
  renderWorld();
  updateAIPanelUI();
  setStatus('CURRICULUM PPO | FRAME #1', false);
  window.requestAnimationFrame(mainLoop);
})();
</script>

