        ep.heartsKeptBonus += player.hp * 1000;
        ep.stepRewardAccumulator += REWARD_CFG.sectorClear;
        ep.stagnantFrames = 0;
      }
    }
  }

  // ===========================================================================
  // 8. RENDERING & LIVE LIDAR RAY VISUALIZATION
  // ===========================================================================
  function renderWorld() {
    if (!ctx || !player) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    var camX = Math.max(0, player.x + player.w / 2 - canvas.width * 0.32);
    if (!aiEnabled) { mouse.worldX = mouse.x + camX; mouse.worldY = mouse.y; }

    ctx.save(); ctx.translate(-Math.floor(camX), 0);
    var startCol = Math.max(0, Math.floor(camX / TILE) - 1);
    var endCol = Math.min(worldCols - 1, Math.ceil((camX + canvas.width) / TILE) + 1);

    for (var r = 0; r < MAP_ROWS; r++) {
      for (var c = startCol; c <= endCol; c++) {
        ctx.fillStyle = (c + r) % 2 === 0 ? '#10121f' : '#141726'; ctx.fillRect(c * TILE, r * TILE, TILE, TILE);
        var vCount = breadcrumbs[c + ',' + r] || 0;
