    }

    for (var pi = 0; pi < portals.length; pi++) {
      var pt = portals[pi];
      if (!pt.gemTaken && Math.hypot((player.x + 9) - (pt.gemX + 10), (player.y + 12) - (pt.gemY + 10)) < 24) {
        pt.gemTaken = true; ep.coinsCollected++; ep.coinReward += REWARD_CFG.coinReward * 2; ep.stepRewardAccumulator += REWARD_CFG.coinReward * 2;
