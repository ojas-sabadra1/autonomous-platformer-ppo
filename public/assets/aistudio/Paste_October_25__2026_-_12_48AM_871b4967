<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shipius Magos: 5-Stage Curriculum RL & PPO-GAE Robotics Lab</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #05060a;
      color: #e0e6ed;
      font-family: 'Courier New', Courier, monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      min-height: 100vh;
      padding: 6px;
      overflow-x: hidden;
      user-select: none;
    }
    #top-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 6px;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 1280px;
      background: #0d101b;
      padding: 6px 10px;
      border: 2px solid #252c44;
      border-radius: 6px;
    }
    #engine-status {
      font-size: 11px;
      font-weight: bold;
      padding: 4px 8px;
      border-radius: 4px;
      background: #0e2918;
      color: #4eed84;
      border: 1px solid #28663e;
      min-width: 235px;
      text-align: center;
    }
    .btn {
      background: #141826;
      color: #4eed84;
      border: 1px solid #2e3856;
      padding: 5px 9px;
      font-family: inherit;
      font-size: 11px;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
    }
    .btn:hover { background: #222942; border-color: #4eed84; }
    .btn.active { background: #1c422a; border-color: #4eed84; color: #fff; }
    .btn-ai { color: #ffd700; border-color: #6b581e; }
    .btn-ai.active { background: #4d3d10; border-color: #ffd700; color: #fff; }
    .btn-export { color: #00ffea; border-color: #1a5c66; background: #0e2229; }
    .btn-export:hover { background: #163842; border-color: #00ffea; }
    .btn-danger { color: #ff5c6c; border-color: #5c2630; }
    .btn-danger:hover { background: #3d151d; border-color: #ff5c6c; }

    #speed-controls {
      display: flex;
      align-items: center;
      gap: 4px;
      background: #080a12;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid #252c44;
    }

    #main-layout {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      max-width: 1280px;
      width: 100%;
      justify-content: center;
    }
    #game-frame {
      position: relative;
      box-shadow: 0 14px 45px rgba(0, 0, 0, 0.95);
      border: 3px solid #252c44;
      border-radius: 6px;
      background: #0a0c14;
      overflow: hidden;
      cursor: crosshair;
      flex-shrink: 0;
    }
    canvas { display: block; image-rendering: pixelated; }

    .side-panel {
      width: 285px;
      height: 476px;
      background: #0d101b;
      border: 3px solid #252c44;
      border-radius: 6px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      font-size: 10.5px;
      flex-shrink: 0;
    }
    .panel-title {
      color: #ffd700;
      font-size: 11px;
      font-weight: bold;
      border-bottom: 1px solid #252c44;
      padding-bottom: 2px;
      margin-bottom: 4px;
      text-align: center;
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 2px;
      color: #a4b0cc;
    }
    .stat-val { font-weight: bold; color: #fff; }
    .pos { color: #4eed84; }
    .neg { color: #ff5263; }
    .gold { color: #ffd700; }
    .cyan { color: #00ffea; }

    .slider-group {
      margin-bottom: 2px;
      background: #080a12;
      padding: 2px 6px;
      border-radius: 4px;
      border: 1px solid #1b2133;
    }
    .slider-header {
      display: flex;
      justify-content: space-between;
      font-size: 9px;
      margin-bottom: 1px;
    }
    .slider-group input[type=range] {
      width: 100%;
      height: 8px;
      accent-color: #4eed84;
      cursor: pointer;
    }

    #history-list {
      height: 64px;
      overflow-y: auto;
      background: #080a10;
      border: 1px solid #1d2336;
      padding: 4px;
      font-size: 9.5px;
      line-height: 1.35;
    }
    #hint-bar {
      margin-top: 6px;
      font-size: 11px;
      color: #98a3bd;
      text-align: center;
    }
    #hint-bar span { color: #4eed84; font-weight: bold; }
  </style>
</head>
<body>

<div id="top-bar">
  <div id="engine-status">CURRICULUM PPO-GAE: READY</div>
  <button class="btn btn-ai active" id="btn-ai" type="button">[B] PPO-GAE Robot Brain: ON</button>
  <button class="btn" id="btn-pause" type="button">[P] Pause / Stop</button>

  <div id="speed-controls">
    <span style="font-size:11px; color:#00ffea; font-weight:bold;">SPEED:</span>
    <button class="btn active" id="spd-1" type="button" data-spd="1">1x</button>
    <button class="btn" id="spd-10" type="button" data-spd="10">10x</button>
    <button class="btn" id="spd-100" type="button" data-spd="100">100x</button>
    <button class="btn" id="spd-1000" type="button" data-spd="1000">1,000x</button>
    <button class="btn" id="spd-10000" type="button" data-spd="10000">10,000x</button>
    <button class="btn" id="spd-100000" type="button" data-spd="100000">100,000x</button>
    <span id="speed-label" style="font-size:11px; color:#ffd700; min-width:58px; text-align:right; font-weight:bold;">1x</span>
  </div>

  <button class="btn btn-export" id="btn-dl-png" type="button">Save Graph (.PNG)</button>
  <button class="btn btn-export" id="btn-dl-csv" type="button">Save Data (.CSV)</button>
  <button class="btn btn-export" id="btn-dl-json" type="button">Save Brain (.JSON)</button>
  <button class="btn btn-export" id="btn-ul-json" type="button">Load Brain (.JSON)</button>
  <input type="file" id="file-input-json" accept=".json" style="display:none;">
  <button class="btn btn-danger" id="btn-wipe" type="button">Wipe Brain (0.00 Prior)</button>
</div>

<div id="main-layout">
  <!-- LEFT PANEL: ROBOTICS LOCOMOTION REWARD SLIDERS + ACTOR-CRITIC POLICY -->
  <div class="side-panel">
    <div>
      <div class="panel-title">ROBOTICS VELOCITY & SAFETY REWARDS</div>
      <div class="slider-group">
        <div class="slider-header"><span class="cyan">Target +Vx Tracking (/m):</span><span class="stat-val cyan" id="lbl-xdist">+1,000</span></div>
        <input type="range" id="sl-xdist" min="100" max="2500" step="50" value="1000">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="neg">Reverse -Vx Penalty (/m):</span><span class="stat-val neg" id="lbl-back">-1,500</span></div>
        <input type="range" id="sl-back" min="100" max="4000" step="50" value="1500">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="neg">Collision / Heart Lost:</span><span class="stat-val neg" id="lbl-heart">-20,000</span></div>
        <input type="range" id="sl-heart" min="2000" max="50000" step="1000" value="20000">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="neg">Terminal Fall / Stall:</span><span class="stat-val neg" id="lbl-death">-65,000</span></div>
        <input type="range" id="sl-death" min="10000" max="150000" step="2500" value="65000">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="pos">Gap / Obstacle Clearance:</span><span class="stat-val pos" id="lbl-evade">+6,000</span></div>
        <input type="range" id="sl-evade" min="500" max="12000" step="250" value="6000">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="gold">Sector Waypoint Reached:</span><span class="stat-val gold" id="lbl-sector">+25,000</span></div>
        <input type="range" id="sl-sector" min="5000" max="60000" step="1000" value="25000">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="pos">Dynamic Threat Neutralized:</span><span class="stat-val pos" id="lbl-ghost">+2,500</span></div>
        <input type="range" id="sl-ghost" min="100" max="10000" step="100" value="2500">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="neg">Actuator / Spell Cost:</span><span class="stat-val neg" id="lbl-bullet">-800</span></div>
        <input type="range" id="sl-bullet" min="50" max="5000" step="50" value="800">
      </div>
      <div class="slider-group">
        <div class="slider-header"><span class="gold">Bonus Node Collected:</span><span class="stat-val gold" id="lbl-coin">+1,000</span></div>
        <input type="range" id="sl-coin" min="100" max="5000" step="100" value="1000">
      </div>
    </div>

    <div>
      <div class="panel-title">ACTOR π(a|z) & ADVANTAGE A(z,a)</div>
      <div class="stat-row"><span>Act #0 (Left):</span><span class="stat-val" id="ui-w0">16.7% (A:+0.0)</span></div>
      <div class="stat-row"><span>Act #1 (Right):</span><span class="stat-val" id="ui-w1">16.7% (A:+0.0)</span></div>
      <div class="stat-row"><span>Act #2 (Jump):</span><span class="stat-val" id="ui-w2">16.7% (A:+0.0)</span></div>
      <div class="stat-row"><span>Act #3 (Leap+R):</span><span class="stat-val" id="ui-w3">16.7% (A:+0.0)</span></div>
      <div class="stat-row"><span>Act #4 (Climb/E):</span><span class="stat-val" id="ui-w4">16.7% (A:+0.0)</span></div>
      <div class="stat-row"><span>Act #5 (Fire+R):</span><span class="stat-val" id="ui-w5">16.7% (A:+0.0)</span></div>
    </div>
  </div>

  <!-- CENTER: CANVAS -->
  <div id="game-frame">
    <canvas id="canvas" width="660" height="476"></canvas>
  </div>

  <!-- RIGHT PANEL: TELEMETRY & GRAPH -->
  <div class="side-panel">
    <div>
      <div class="panel-title">CURRICULUM & PPO TELEMETRY</div>
      <div class="stat-row"><span>Episode (Rollout #):</span><span class="stat-val gold" id="ui-gen">#1</span></div>
      <div class="stat-row"><span>Curriculum Zone:</span><span class="stat-val gold" id="ui-stage">1: LAVA ONLY</span></div>
      <div class="stat-row"><span>Exteroceptive Latent (z):</span><span class="stat-val cyan" id="ui-mode">FLAT RUNWAY</span></div>
      <div class="stat-row"><span>Critic Value V(z):</span><span class="stat-val pos" id="ui-seed">+0.0</span></div>
      <div class="stat-row"><span>MAX X TRAVELLED:</span><span class="stat-val cyan" style="font-size:12px;" id="ui-max-dist">0.0m (Sec 1)</span></div>
      <div class="stat-row"><span>MAX SCORE TILL NOW:</span><span class="stat-val pos" style="font-size:12px;" id="ui-best">0</span></div>
      <div class="stat-row"><span>Physics Steps/Sec:</span><span class="stat-val cyan" id="ui-sps">60</span></div>
    </div>

    <div>
      <div class="panel-title">CURRENT ROLLOUT REWARDS</div>
      <div class="stat-row"><span>Velocity Tracking (+X):</span><span class="stat-val cyan" id="ui-r-dist">+0</span></div>
      <div class="stat-row"><span>Obstacles Cleared:</span><span class="stat-val pos" id="ui-r-evade">+0 (0)</span></div>
      <div class="stat-row"><span>Waypoints Reached:</span><span class="stat-val gold" id="ui-r-sec">+0 (0)</span></div>
      <div class="stat-row"><span>Threats Neutralized:</span><span class="stat-val pos" id="ui-r-ghost">+0 (0)</span></div>
      <div class="stat-row"><span>Bonus Nodes:</span><span class="stat-val gold" id="ui-r-coin">+0 (0)</span></div>
      <div class="stat-row"><span>Integrity Bonus:</span><span class="stat-val pos" id="ui-r-hp">+5000 (5)</span></div>
      <div class="stat-row"><span>Actuator Energy Cost:</span><span class="stat-val neg" id="ui-r-bul">-0 (0)</span></div>
      <div class="stat-row"><span>Collision / Stall Cost:</span><span class="stat-val neg" id="ui-r-dmg">-0 (0)</span></div>
      <div class="stat-row" style="border-top:1px solid #252c44; padding-top:2px; margin-top:2px;">
        <span>LIVE NET RETURN:</span><span class="stat-val cyan" style="font-size:12px;" id="ui-r-total">0</span>
      </div>
    </div>

    <div>
      <div class="panel-title">MAX X (m) VS EPISODES GRAPH</div>
      <canvas id="chart-canvas" width="254" height="68" style="background:#080a10; border:1px solid #1d2336; margin-bottom:4px;"></canvas>
      <div id="history-list"></div>
    </div>
  </div>
</div>

<div id="hint-bar">
  <span>5-Stage Curriculum:</span> 0–1000m: Lava Only | 1000–2000m: Spikes Only | 2000–3000m: Ladders | 3000–4000m: Ghosts | 4000m+: Combined Mastery
</div>

<script>
(function() {
  "use strict";

  function setStatus(text, isErr) {
    var badge = document.getElementById('engine-status');
    if (!badge) return;
    badge.textContent = text;
    badge.style.background = isErr ? '#5a121b' : '#0e2918';
    badge.style.color = isErr ? '#ff7b89' : '#4eed84';
  }

  window.onerror = function(msg, url, line) {
    setStatus('RECOVERED L' + line + ': ' + msg, true);
    return true;
  };

  function safeNum(val, fallback) {
    var n = Number(val);
    return (typeof n === 'number' && isFinite(n)) ? n : (fallback || 0);
  }

  function safeSetText(id, text) {
    var el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function safeGetInputNum(id, fallback) {
    var el = document.getElementById(id);
    if (el) return safeNum(el.value, fallback);
    return fallback;
  }

  function bindEventSafe(id, evType, fn) {
    var el = document.getElementById(id);
    if (el) el.addEventListener(evType, fn);
  }

  function bindClickSafe(id, fn) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('click', function(e) {
        this.blur();
        fn(e);
      });
    }
  }

  // ===========================================================================
  // 1. ROBOTICS REWARD HYPERPARAMETERS
  // ===========================================================================
  var REWARD_CFG = {
    xDistPerMeter: 1000,
    backPenaltyPerMeter: 1500,
    heartLostPenalty: 20000,
    deathPenalty: 65000,
    evadeReward: 6000,
    sectorClear: 25000,
    ghostKill: 2500,
    bulletCost: 800,
    coinReward: 1000
  };

  function syncSliders() {
    REWARD_CFG.xDistPerMeter = safeGetInputNum('sl-xdist', 1000);
    REWARD_CFG.backPenaltyPerMeter = safeGetInputNum('sl-back', 1500);
    REWARD_CFG.heartLostPenalty = safeGetInputNum('sl-heart', 20000);
    REWARD_CFG.deathPenalty = safeGetInputNum('sl-death', 65000);
    REWARD_CFG.evadeReward = safeGetInputNum('sl-evade', 6000);
    REWARD_CFG.sectorClear = safeGetInputNum('sl-sector', 25000);
    REWARD_CFG.ghostKill = safeGetInputNum('sl-ghost', 2500);
    REWARD_CFG.bulletCost = safeGetInputNum('sl-bullet', 800);
    REWARD_CFG.coinReward = safeGetInputNum('sl-coin', 1000);

    safeSetText('lbl-xdist', '+' + REWARD_CFG.xDistPerMeter.toLocaleString());
    safeSetText('lbl-back', '-' + REWARD_CFG.backPenaltyPerMeter.toLocaleString());
    safeSetText('lbl-heart', '-' + REWARD_CFG.heartLostPenalty.toLocaleString());
    safeSetText('lbl-death', '-' + REWARD_CFG.deathPenalty.toLocaleString());
    safeSetText('lbl-evade', '+' + REWARD_CFG.evadeReward.toLocaleString());
    safeSetText('lbl-sector', '+' + REWARD_CFG.sectorClear.toLocaleString());
    safeSetText('lbl-ghost', '+' + REWARD_CFG.ghostKill.toLocaleString());
    safeSetText('lbl-bullet', '-' + REWARD_CFG.bulletCost.toLocaleString());
    safeSetText('lbl-coin', '+' + REWARD_CFG.coinReward.toLocaleString());
  }

  bindEventSafe('sl-ghost', 'input', function() {
    var gVal = safeGetInputNum('sl-ghost', 2500);
    var bInput = document.getElementById('sl-bullet');
    if (bInput) bInput.value = Math.max(50, Math.round(gVal * 0.32));
    syncSliders();
  });

  bindEventSafe('sl-xdist', 'input', function() {
    var xVal = safeGetInputNum('sl-xdist', 1000);
    var bkInput = document.getElementById('sl-back');
    if (bkInput) bkInput.value = Math.round(xVal * 1.5);
    syncSliders();
  });

  var sliderIds = ['sl-death', 'sl-sector', 'sl-xdist', 'sl-back', 'sl-evade', 'sl-bullet', 'sl-coin', 'sl-heart'];
  for (var sIdx = 0; sIdx < sliderIds.length; sIdx++) {
    bindEventSafe(sliderIds[sIdx], 'input', syncSliders);
  }

  // ===========================================================================
  // 2. CANVAS & DESKTOP INPUTS
  // ===========================================================================
  var TILE = 28;
  var MAP_ROWS = 17;
  var SECTOR_COLS = 34;

  var canvas = document.getElementById('canvas');
  var ctx = canvas ? canvas.getContext('2d') : null;
  var mouse = { x: 340, y: 240, worldX: 340, worldY: 240, down: false };
  var keys = {};

  var aiEnabled = true;
  var isPaused = false;
  var targetSimSpeed = 1;
  var actualStepsThisSec = 0;
  var displayedSPS = 60;
  var lastSpsTime = Date.now();
  var frameCounter = 0;

  var audioCtx = null;
  function playTone(freq, type, dur, endFreq, vol) {
    if (isPaused || targetSimSpeed > 10) return;
    try {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      var o = audioCtx.createOscillator();
      var g = audioCtx.createGain();
      o.type = type || 'sine';
      o.frequency.setValueAtTime(freq, audioCtx.currentTime);
      if (endFreq) o.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), audioCtx.currentTime + dur);
      g.gain.setValueAtTime(vol || 0.05, audioCtx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
      o.connect(g);
      g.connect(audioCtx.destination);
      o.start();
      o.stop(audioCtx.currentTime + dur);
    } catch (e) {}
  }

  if (canvas) {
    canvas.addEventListener('mousemove', function(e) {
      var rect = canvas.getBoundingClientRect();
      mouse.x = (e.clientX - rect.left) * (canvas.width / rect.width);
      mouse.y = (e.clientY - rect.top) * (canvas.height / rect.height);
    });
    canvas.addEventListener('mousedown', function(e) {
      if (e.button === 0) mouse.down = true;
    });
  }

  window.addEventListener('mouseup', function(e) { if (e.button === 0) mouse.down = false; });
  window.addEventListener('keydown', function(e) {
    keys[e.code] = true;
    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space'].indexOf(e.code) !== -1) e.preventDefault();
    if (e.code === 'KeyB') window.toggleAI();
    if (e.code === 'KeyP') window.togglePause();
    if (e.code === 'KeyR') concludeAttempt("Manual Reset", false);
  });
  window.addEventListener('keyup', function(e) { keys[e.code] = false; });

  // ===========================================================================
  // 3. AUTONOMOUS ROBOTICS BRAIN: ACTOR-CRITIC PPO-CLIP + GAE(lambda) + MPPI
  // ===========================================================================
  var NUM_ACTIONS = 6;
  var NUM_FEATURES = 8;
  var RL_STORAGE_KEY = 'shipius_curriculum_ppo_v38';

  function createZeroMatrix() {
    var mat = [];
    for (var a = 0; a < NUM_ACTIONS; a++) {
      mat.push([0, 0, 0, 0, 0, 0, 0, 0]);
    }
    return mat;
  }

  var rlBrain = {
    attempt: 1,
    bestReward: null,
    maxDistMeters: 0,
    maxSector: 1,
    actorWeights: createZeroMatrix(),
    eliteActorWeights: createZeroMatrix(),
    criticWeights: [0, 0, 0, 0, 0, 0, 0, 0],
    latentActorLogits: {},
    latentCriticV: {},
    latentActionAdv: {},
    latentCounts: {},
    lastProbs: [0.167, 0.167, 0.167, 0.167, 0.167, 0.167],
    lastAdv: [0, 0, 0, 0, 0, 0],
    lastCriticVal: 0,
    activeContextText: 'FLAT RUNWAY',
    activeStageText: '1: LAVA ONLY',
    currentSeedStr: 'CUR-1',
    fullHistory: []
  };

  function cloneMatrix(mat) {
    var out = [];
    for (var a = 0; a < NUM_ACTIONS; a++) {
      var row = [];
      for (var f = 0; f < NUM_FEATURES; f++) {
        row.push(safeNum(mat && mat[a] ? mat[a][f] : 0, 0));
      }
      out.push(row);
    }
    return out;
  }

  function sanitizeBrain(obj) {
    if (!obj || typeof obj !== 'object') return;
    rlBrain.attempt = Math.max(1, Math.floor(safeNum(obj.attempt, 1)));
    rlBrain.bestReward = (obj.bestReward !== null && obj.bestReward !== undefined) ? safeNum(obj.bestReward, 0) : null;
    rlBrain.maxDistMeters = Math.max(0, safeNum(obj.maxDistMeters, 0));
    rlBrain.maxSector = Math.max(1, Math.floor(safeNum(obj.maxSector, 1)));

    if (Array.isArray(obj.actorWeights) && obj.actorWeights.length === NUM_ACTIONS) {
      rlBrain.actorWeights = cloneMatrix(obj.actorWeights);
    }
    if (Array.isArray(obj.eliteActorWeights) && obj.eliteActorWeights.length === NUM_ACTIONS) {
      rlBrain.eliteActorWeights = cloneMatrix(obj.eliteActorWeights);
    } else {
      rlBrain.eliteActorWeights = cloneMatrix(rlBrain.actorWeights);
    }
    if (Array.isArray(obj.criticWeights) && obj.criticWeights.length === NUM_FEATURES) {
      for (var f = 0; f < NUM_FEATURES; f++) rlBrain.criticWeights[f] = safeNum(obj.criticWeights[f], 0);
    }

    if (obj.latentActorLogits && typeof obj.latentActorLogits === 'object') rlBrain.latentActorLogits = obj.latentActorLogits;
    if (obj.latentCriticV && typeof obj.latentCriticV === 'object') rlBrain.latentCriticV = obj.latentCriticV;
    if (obj.latentActionAdv && typeof obj.latentActionAdv === 'object') rlBrain.latentActionAdv = obj.latentActionAdv;
    if (obj.latentCounts && typeof obj.latentCounts === 'object') rlBrain.latentCounts = obj.latentCounts;

    if (Array.isArray(obj.fullHistory)) {
      var cleanHistory = [];
      for (var i = 0; i < obj.fullHistory.length; i++) {
        var item = obj.fullHistory[i];
        if (item && typeof item === 'object' && isFinite(item.attempt) && isFinite(item.dist)) {
          cleanHistory.push(item);
        }
      }
      rlBrain.fullHistory = cleanHistory;
    }
  }

  function loadRLBrain() {
    try {
      var raw = window.localStorage.getItem(RL_STORAGE_KEY);
      if (raw) sanitizeBrain(JSON.parse(raw));
    } catch (e) {}
  }

  function saveRLBrain() {
    try {
      var copy = {
        attempt: rlBrain.attempt,
        bestReward: rlBrain.bestReward,
        maxDistMeters: rlBrain.maxDistMeters,
        maxSector: rlBrain.maxSector,
        actorWeights: rlBrain.actorWeights,
        eliteActorWeights: rlBrain.eliteActorWeights,
        criticWeights: rlBrain.criticWeights,
        latentActorLogits: rlBrain.latentActorLogits,
        latentCriticV: rlBrain.latentCriticV,
        latentActionAdv: rlBrain.latentActionAdv,
        latentCounts: rlBrain.latentCounts,
        fullHistory: rlBrain.fullHistory.slice(-400)
      };
      window.localStorage.setItem(RL_STORAGE_KEY, JSON.stringify(copy));
    } catch (e) {}
  }

  function wipeBrain() {
    try { window.localStorage.removeItem(RL_STORAGE_KEY); } catch (e) {}
    rlBrain = {
      attempt: 1,
      bestReward: null,
      maxDistMeters: 0,
      maxSector: 1,
      actorWeights: createZeroMatrix(),
      eliteActorWeights: createZeroMatrix(),
      criticWeights: [0, 0, 0, 0, 0, 0, 0, 0],
      latentActorLogits: {},
      latentCriticV: {},
      latentActionAdv: {},
      latentCounts: {},
      lastProbs: [0.167, 0.167, 0.167, 0.167, 0.167, 0.167],
      lastAdv: [0, 0, 0, 0, 0, 0],
      lastCriticVal: 0,
      activeContextText: 'FLAT RUNWAY',
      activeStageText: '1: LAVA ONLY',
      currentSeedStr: 'CUR-1',
      fullHistory: []
    };
    startNewAttempt();
  }

  // ===========================================================================
  // 4. 5-STAGE CURRICULUM RANDOMIZED LEVEL GENERATOR (1,000m PER STAGE!)
  // ===========================================================================
  // Note: 1 Sector = 34 tiles * 28px = 952px / 12 px_per_meter = 79.33 meters.
  // Therefore, 13 Sectors = ~1,031 meters!
  //   Stage 1 (0m - 1,000m   | Sectors 1..13):  ONLY Lava Pits (1-2 tiles wide)
  //   Stage 2 (1,000m - 2,000m | Sectors 14..26): ONLY Floor Spikes
  //   Stage 3 (2,000m - 3,000m | Sectors 27..39): ONLY Ladders & Elevated Platforms (+ Lava)
  //   Stage 4 (3,000m - 4,000m | Sectors 40..52): ONLY Patrolling Ghosts on Flat Ground
  //   Stage 5 (4,000m+         | Sectors 53+):    Gradual Combined Mastery of All Obstacles
  var worldCols = 0;
  var grid = [];
  var generatedSectors = 0;

  var player = null;
  var ghosts = [];
  var chests = [];
  var coins = [];
  var portals = [];
  var spells = [];
  var breadcrumbs = {};
  var ep = {};
  var isConcluding = false;

  function randInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function getCurriculumStageForMeters(meters) {
    if (meters < 1000) return { id: 1, label: '1: LAVA ONLY (0-1km)' };
    if (meters < 2000) return { id: 2, label: '2: SPIKES ONLY (1-2km)' };
    if (meters < 3000) return { id: 3, label: '3: LADDERS (2-3km)' };
    if (meters < 4000) return { id: 4, label: '4: GHOSTS ONLY (3-4km)' };
    return { id: 5, label: '5: COMBINED MASTERY (4km+)' };
  }

  function initWorld() {
    grid = [];
    for (var r = 0; r < MAP_ROWS; r++) { grid[r] = []; }
    worldCols = 0;
    generatedSectors = 0;
    ghosts = []; chests = []; coins = []; portals = []; spells = []; breadcrumbs = {};
    rlBrain.currentSeedStr = 'CUR-' + randInt(100, 999);
    appendCurriculumSector();
    appendCurriculumSector();
    appendCurriculumSector();
  }

  function pruneEntities() {
    if (!player) return;
    var safeX = player.x - 1200;
    var g2 = []; for (var i = 0; i < ghosts.length; i++) if (ghosts[i].x > safeX || ghosts[i].hp > 0) g2.push(ghosts[i]); ghosts = g2;
    var ch2 = []; for (var j = 0; j < chests.length; j++) if (chests[j].x > safeX) ch2.push(chests[j]); chests = ch2;
    var co2 = []; for (var k = 0; k < coins.length; k++) if (coins[k].x > safeX && !coins[k].collected) co2.push(coins[k]); coins = co2;
    var po2 = []; for (var p = 0; p < portals.length; p++) if (portals[p].c * TILE > safeX) po2.push(portals[p]); portals = po2;
  }

  function spawnRandomGhost(minC, maxC, rowY) {
    if (maxC <= minC + 1) return;
    var minPx = minC * TILE;
    var maxPx = maxC * TILE;
    var randStartPx = minPx + Math.random() * (maxPx - minPx);
    ghosts.push({
      x: randStartPx,
      y: rowY * TILE,
      minX: minPx,
      maxX: maxPx,
      vx: 1.05 + Math.random() * 0.2,
      dir: Math.random() < 0.5 ? 1 : -1,
      hp: 2,
      maxHp: 2,
      bob: Math.random() * 6.28
    });
  }

  function appendCurriculumSector() {
    generatedSectors++;
    var sIdx = generatedSectors;
    var startC = worldCols;
    var endC = startC + SECTOR_COLS;

    // Determine exact distance (meters) at the start of this sector
    var sectorStartMeters = Math.max(0, ((startC * TILE) - (3 * TILE)) / 12);
    var stageInfo = getCurriculumStageForMeters(sectorStartMeters);
    var stageId = stageInfo.id;

    for (var r = 0; r < MAP_ROWS; r++) {
      for (var c = startC; c < endC; c++) {
        if (r === 0 || r >= 14) grid[r][c] = '1';
        else if (r === 13) grid[r][c] = '2';
        else grid[r][c] = '.';
      }
    }
    if (sIdx === 1) {
      for (var r0 = 0; r0 < MAP_ROWS; r0++) grid[r0][0] = '1';
    }

    var curC = startC + (sIdx === 1 ? 8 : 5);
    var safeEndC = startC + 29;

    while (curC < safeEndC - 3) {
      var obstacleType = 'lava';

      if (stageId === 1) {
        // STAGE 1 (0m - 1,000m): 100% LAVA PITS ONLY
        obstacleType = 'lava';
      } else if (stageId === 2) {
        // STAGE 2 (1,000m - 2,000m): 100% FLOOR SPIKES ONLY
        obstacleType = 'spike';
      } else if (stageId === 3) {
        // STAGE 3 (2,000m - 3,000m): LADDERS & PLATFORMS (+ occasional Lava Pit)
        obstacleType = (Math.random() < 0.7) ? 'ladder' : 'lava';
      } else if (stageId === 4) {
        // STAGE 4 (3,000m - 4,000m): GHOSTS ONLY ON FLAT RUNWAYS
        obstacleType = 'ghost_flat';
      } else {
        // STAGE 5 (4,000m+): FULL COMBINED MASTERY
        var roll = Math.random();
        if (roll < 0.30) obstacleType = 'lava';
        else if (roll < 0.58) obstacleType = 'spike';
        else if (roll < 0.80) obstacleType = 'ladder';
        else obstacleType = 'ghost_flat';
      }

      if (obstacleType === 'lava') {
        var pitWidth = randInt(1, 2);
        if (curC + pitWidth < safeEndC) {
          for (var p = 0; p < pitWidth; p++) {
            grid[13][curC + p] = '.';
            grid[14][curC + p] = 'L';
          }
          coins.push({ x: (curC + pitWidth * 0.5) * TILE, y: 10 * TILE, collected: false, kind: 'gem' });
          curC += pitWidth + randInt(5, 7); // Generous runway so each jump is cleanly isolated
        } else {
          curC += 4;
        }
      } else if (obstacleType === 'spike') {
        grid[12][curC] = '4';
        coins.push({ x: curC * TILE + 6, y: 9 * TILE + 10, collected: false, kind: 'gem' });
        curC += 1 + randInt(5, 7);
      } else if (obstacleType === 'ladder') {
        var platLen = randInt(5, 7);
        if (curC + platLen < safeEndC) {
          for (var rl = 9; rl <= 12; rl++) grid[rl][curC] = '3';
          for (var cl = curC + 1; cl <= curC + platLen; cl++) grid[9][cl] = '2';

          chests.push({ x: (curC + 2) * TILE, y: 8 * TILE, opened: false, item: 'crimson' });
          coins.push({ x: (curC + 4) * TILE + 6, y: 8 * TILE, collected: false, kind: 'gem' });
          curC += platLen + randInt(4, 6);
        } else {
          curC += 4;
        }
      } else if (obstacleType === 'ghost_flat') {
        var patrolLen = randInt(5, 7);
        if (curC + patrolLen < safeEndC) {
          spawnRandomGhost(curC, curC + patrolLen, 11);
          coins.push({ x: (curC + 2) * TILE + 6, y: 12 * TILE, collected: false, kind: 'coin' });
          curC += patrolLen + randInt(4, 6);
        } else {
          curC += 4;
        }
      }
    }

    grid[11][startC + 32] = '5'; grid[12][startC + 32] = '5';
    portals.push({ c: startC + 32, sector: sIdx, passed: false, gemTaken: false, gemX: (startC + 30) * TILE, gemY: 11 * TILE });

    worldCols = endC;
    pruneEntities();
  }

  // ===========================================================================
  // 5. PPO-CLIP + GAE(lambda) ROLLOUT BUFFER & WIN-STAY SATISFICING LEARNER
  // ===========================================================================
  function startNewAttempt() {
    isConcluding = false;
    initWorld();

    player = {
      x: 3 * TILE, y: 12 * TILE, w: 18, h: 24, vx: 0, vy: 0,
      speed: 3.6, jumpPower: 8.5, onGround: false, onLadder: false,
      coyote: 0, jumpBuf: 0, facing: 1, aimAngle: 0,
      maxHp: 5, hp: 5, maxMana: 100, mana: 100, invuln: 0, castCd: 0,
      weapon: 'apprentice', sector: 1
    };

    ep = {
      ghostKills: 0, ghostReward: 0, sectorsCleared: 0, sectorReward: 0,
      hazardsCleared: 0, evadeReward: 0, lastClearedCol: -1,
      coinsCollected: 0, coinReward: 0, heartsKeptBonus: 0, heartsLost: 0, damagePenalty: 0,
      startX: player.x, maxPxReached: player.x, distReward: 0, bulletsFired: 0, bulletPenalty: 0,
      loopPenalty: 0, framesAlive: 0, stagnantFrames: 0, deathPenalty: 0,
      aimAngle: 0, currentAction: 1,
      macroAction: null, macroTimer: 0,
      lastDecisionFeatures: null,
      lastDecisionKey: null,
      lastDecisionAction: null,
      lastDecisionProb: 0.167,
      lastDecisionX: player.x,
      stepRewardAccumulator: 0,
      rolloutBuffer: [],
      lidarRays: [],
      peakNetScoreThisRun: 0
    };
  }

  function getDistanceMeters() {
    if (!player || !ep) return 0;
    return Math.max(0, Number(((ep.maxPxReached - ep.startX) / 12).toFixed(1)));
  }

  function getNetReward() {
    if (!player || !ep) return 0;
    return Math.round(
      ep.distReward + ep.sectorReward + ep.ghostReward + ep.evadeReward + ep.coinReward +
      ep.heartsKeptBonus + (player.hp * 1000) - ep.bulletPenalty - ep.damagePenalty - ep.loopPenalty - ep.deathPenalty
    );
  }

  function ensureLatentCluster(zKey) {
    if (!rlBrain.latentActorLogits[zKey] || rlBrain.latentActorLogits[zKey].length !== NUM_ACTIONS) {
      rlBrain.latentActorLogits[zKey] = [0, 0, 0, 0, 0, 0];
    }
    if (typeof rlBrain.latentCriticV[zKey] !== 'number' || !isFinite(rlBrain.latentCriticV[zKey])) {
      rlBrain.latentCriticV[zKey] = 0;
    }
    if (!rlBrain.latentActionAdv[zKey] || rlBrain.latentActionAdv[zKey].length !== NUM_ACTIONS) {
      rlBrain.latentActionAdv[zKey] = [0, 0, 0, 0, 0, 0];
    }
    if (!rlBrain.latentCounts[zKey] || rlBrain.latentCounts[zKey].length !== NUM_ACTIONS) {
      rlBrain.latentCounts[zKey] = [0, 0, 0, 0, 0, 0];
    }
  }

  function evaluateCriticV(features, zKey) {
    ensureLatentCluster(zKey);
    var v = safeNum(rlBrain.latentCriticV[zKey], 0);
    for (var f = 0; f < NUM_FEATURES; f++) {
      v += safeNum(rlBrain.criticWeights[f], 0) * safeNum(features[f], 0);
    }
    return v;
  }

  function evaluateActorDistribution(features, zKey) {
    ensureLatentCluster(zKey);
    var logits = [0, 0, 0, 0, 0, 0];
    var maxL = -Infinity;
    for (var a = 0; a < NUM_ACTIONS; a++) {
      // Latent cluster memory has 2.5x priority over shared linear weights so new stage obstacles never corrupt earlier stages!
      var sum = safeNum(rlBrain.latentActorLogits[zKey][a], 0) * 2.5 + safeNum(rlBrain.latentActionAdv[zKey][a], 0) * 1.8;
      for (var f = 0; f < NUM_FEATURES; f++) {
        sum += safeNum(rlBrain.actorWeights[a][f], 0) * safeNum(features[f], 0) * 0.35;
      }
      logits[a] = sum;
      if (sum > maxL) maxL = sum;
    }

    var exps = [0, 0, 0, 0, 0, 0];
    var sumExp = 0;
    for (var b = 0; b < NUM_ACTIONS; b++) {
      var e = Math.exp(Math.max(-20, Math.min(20, logits[b] - maxL)));
      exps[b] = e;
      sumExp += e;
    }
    var probs = [0, 0, 0, 0, 0, 0];
    for (var c = 0; c < NUM_ACTIONS; c++) {
      probs[c] = exps[c] / (sumExp || 1);
    }
    return { probs: probs, logits: logits };
  }

  function recordAndStepUpdate(features, zKey, actionIdx, oldProb, rawReward, nextFeatures, nextZKey) {
    if (!features || !zKey || actionIdx === null || actionIdx === undefined) return;
    ensureLatentCluster(zKey);

    var rScaled = Math.max(-28, Math.min(28, safeNum(rawReward, 0) / 280));
    var vNow = evaluateCriticV(features, zKey);
    var vNext = (nextFeatures && nextZKey) ? evaluateCriticV(nextFeatures, nextZKey) : 0;

    var gamma = 0.72;
    var delta = rScaled + (gamma * vNext) - vNow;

    var advNow = safeNum(rlBrain.latentActionAdv[zKey][actionIdx], 0);
    rlBrain.latentActionAdv[zKey][actionIdx] = Math.max(-65, Math.min(65, advNow + 0.28 * (rScaled - advNow)));

    rlBrain.latentCriticV[zKey] = Math.max(-60, Math.min(60, safeNum(rlBrain.latentCriticV[zKey], 0) + 0.14 * delta));
    rlBrain.latentActorLogits[zKey][actionIdx] = Math.max(-60, Math.min(60, safeNum(rlBrain.latentActorLogits[zKey][actionIdx], 0) + 0.22 * delta));

    for (var f = 0; f < NUM_FEATURES; f++) {
      if (features[f] !== 0) {
        rlBrain.criticWeights[f] = Math.max(-45, Math.min(45, safeNum(rlBrain.criticWeights[f], 0) + 0.04 * delta * features[f]));
        rlBrain.actorWeights[actionIdx][f] = Math.max(-55, Math.min(55, safeNum(rlBrain.actorWeights[actionIdx][f], 0) + 0.06 * delta * features[f]));
      }
    }

    ep.rolloutBuffer.push({
      features: features,
      zKey: zKey,
      action: actionIdx,
      oldProb: Math.max(0.01, safeNum(oldProb, 0.167)),
      reward: rScaled,
      vPred: vNow
    });
    if (ep.rolloutBuffer.length > 220) ep.rolloutBuffer.shift();
  }

  function runPPOClipEpoch() {
    var buf = ep.rolloutBuffer;
    var n = buf.length;
    if (n === 0) return;

    var gamma = 0.75;
    var lam = 0.65;
    var clipEps = 0.20;
    var gae = 0;

    for (var i = n - 1; i >= 0; i--) {
      var step = buf[i];
      var nextV = (i + 1 < n) ? buf[i + 1].vPred : 0;
      var contextChanged = (i + 1 < n && buf[i + 1].zKey !== step.zKey);
      var effLam = contextChanged ? 0.0 : lam;

      var delta = step.reward + (gamma * nextV) - step.vPred;
      gae = delta + (gamma * effLam * gae);
      var adv = Math.max(-25, Math.min(25, gae));

      var curDist = evaluateActorDistribution(step.features, step.zKey);
      var newProb = Math.max(0.01, curDist.probs[step.action]);
      var ratio = newProb / step.oldProb;
      var clippedRatio = Math.max(1.0 - clipEps, Math.min(1.0 + clipEps, ratio));

      var effStep = (ratio * adv <= clippedRatio * adv) ? (ratio * adv) : (clippedRatio * adv);
      var ppoLr = 0.08;

      rlBrain.latentActorLogits[step.zKey][step.action] = Math.max(
        -60,
        Math.min(60, safeNum(rlBrain.latentActorLogits[step.zKey][step.action], 0) + ppoLr * effStep)
      );
    }
  }

  function concludeAttempt(cause, died) {
    if (isConcluding) return;
    isConcluding = true;

    var distM = getDistanceMeters();

    if (died) {
      ep.deathPenalty = REWARD_CFG.deathPenalty;
      if (ep.lastDecisionFeatures !== null && ep.lastDecisionKey !== null && ep.lastDecisionAction !== null) {
        recordAndStepUpdate(
          ep.lastDecisionFeatures,
          ep.lastDecisionKey,
          ep.lastDecisionAction,
          ep.lastDecisionProb,
          -REWARD_CFG.deathPenalty * 0.55,
          null,
          null
        );
      }
    }

    runPPOClipEpoch();

    var finalScore = getNetReward();

    if (distM >= rlBrain.maxDistMeters || rlBrain.bestReward === null || ep.peakNetScoreThisRun >= rlBrain.bestReward) {
      rlBrain.eliteActorWeights = cloneMatrix(rlBrain.actorWeights);
    } else {
      for (var a = 0; a < NUM_ACTIONS; a++) {
        for (var f = 0; f < NUM_FEATURES; f++) {
          rlBrain.actorWeights[a][f] = safeNum(rlBrain.actorWeights[a][f], 0) * 0.85 + safeNum(rlBrain.eliteActorWeights[a][f], 0) * 0.15;
        }
      }
    }

    if (distM > rlBrain.maxDistMeters) rlBrain.maxDistMeters = distM;
    if (rlBrain.bestReward === null || ep.peakNetScoreThisRun > rlBrain.bestReward) {
      rlBrain.bestReward = ep.peakNetScoreThisRun;
    }
    if (player.sector > rlBrain.maxSector) rlBrain.maxSector = player.sector;

    rlBrain.fullHistory.push({
      attempt: rlBrain.attempt, dist: distM, recordDist: rlBrain.maxDistMeters,
      reward: finalScore, peakScore: ep.peakNetScoreThisRun, sectors: ep.sectorsCleared,
      ghosts: ep.ghostKills, evades: ep.hazardsCleared, coins: ep.coinsCollected,
      bullets: ep.bulletsFired, hpLost: ep.heartsLost, frames: ep.framesAlive, cause: cause || 'Ended'
    });

    rlBrain.attempt++;
    if (rlBrain.attempt % 10 === 0 || targetSimSpeed <= 100) saveRLBrain();
    startNewAttempt();
  }

  // ===========================================================================
  // 6. EXTEROCEPTIVE HEIGHTMAP SCANNER & WIN-STAY SATISFICING CONTROLLER
  // ===========================================================================
  function getTile(c, r) {
    if (r < 0 || r >= MAP_ROWS || c < 0) return '1';
    if (c >= worldCols || !grid[r]) return '.';
    return grid[r][c] || '.';
  }

  function isSolidWall(c, r) { return (getTile(c, r) === '1' || getTile(c, r) === '2'); }
  function isTopOfLadder(c, r) { return getTile(c, r) === '3' && getTile(c, r - 1) !== '3'; }
  function hasLineOfSight(x1, y1, x2, y2) {
    var steps = Math.ceil(Math.hypot(x2 - x1, y2 - y1) / 14);
    for (var i = 1; i < steps; i++) {
      var tx = x1 + ((x2 - x1) * i) / steps; var ty = y1 + ((y2 - y1) * i) / steps;
      if (isSolidWall(Math.floor(tx / TILE), Math.floor(ty / TILE))) return false;
    }
    return true;
  }

  function extractMultiModalPerception() {
    var pCx = player.x + player.w / 2;
    var pCy = player.y + player.h / 2;
    var pCol = Math.floor(pCx / TILE);
    var pRow = Math.floor((player.y + player.h - 2) / TILE);

    var curMeters = Math.max(0, (player.x - ep.startX) / 12);
    rlBrain.activeStageText = getCurriculumStageForMeters(curMeters).label;

    var floorNext1 = getTile(pCol + 1, pRow + 1);
    var floorNext2 = getTile(pCol + 2, pRow + 1);
    var wallNext1 = getTile(pCol + 1, pRow);
    var wallNext2 = getTile(pCol + 2, pRow);

    var pitTakeoffNow = (floorNext1 === '.' || floorNext1 === 'L') ? 1.0 : 0.0;
    var pitApproach = (!pitTakeoffNow && (floorNext2 === '.' || floorNext2 === 'L')) ? 1.0 : 0.0;
    var spikeTakeoffNow = (wallNext1 === '4' || (wallNext2 === '4' && (player.x % TILE) > 12)) ? 1.0 : 0.0;
    var ladderHere = (getTile(pCol, pRow) === '3' || wallNext1 === '3' || isSolidWall(pCol + 1, pRow)) ? 1.0 : 0.0;

    var nearestGhost = null; var nearestGDist = 999;
    for (var i = 0; i < ghosts.length; i++) {
      var gh = ghosts[i]; if (gh.hp <= 0) continue;
      if (gh.x + 18 < player.x) continue;
      var gd = Math.hypot((gh.x + 14) - pCx, (gh.y + 14) - pCy);
      if (gd < 195 && gd < nearestGDist && hasLineOfSight(pCx, pCy, gh.x + 14, gh.y + 14)) {
        nearestGDist = gd; nearestGhost = gh; ep.aimAngle = Math.atan2((gh.y + 12) - pCy, (gh.x + 14) - pCx);
      }
    }
    if (!nearestGhost) ep.aimAngle = 0;

    ep.lidarRays = [
      { x2: (pCol + 1.5) * TILE, y2: (pRow + 1.2) * TILE, hazard: pitTakeoffNow > 0 || spikeTakeoffNow > 0 },
      { x2: (pCol + 2.5) * TILE, y2: (pRow + 1.2) * TILE, hazard: pitApproach > 0 }
    ];
    if (nearestGhost) {
      ep.lidarRays.push({ x2: nearestGhost.x + 14, y2: nearestGhost.y + 14, hazard: true });
    }

    var visitsHere = breadcrumbs[pCol + ',' + pRow] || 0;
    var isStuckHere = visitsHere >= 3 ? 1.0 : 0.0;

    var ghostClose = (nearestGhost && nearestGDist < 78) ? 1.0 : 0.0;
    var ghostMed = (nearestGhost && nearestGDist >= 78) ? 1.0 : 0.0;

    var isFlatClear = (!pitTakeoffNow && !pitApproach && !spikeTakeoffNow && !ladderHere && !ghostClose && !ghostMed && !isStuckHere) ? 1.0 : 0.0;

    var contextLabel = 'FLAT RUNWAY';
    if (pitTakeoffNow) contextLabel = 'GAP TAKEOFF SCAN';
    else if (spikeTakeoffNow) contextLabel = 'SPIKE LIDAR SCAN';
    else if (ghostClose) contextLabel = 'THREAT PROXIMITY';
    else if (ghostMed) contextLabel = 'THREAT IN CONE';
    else if (pitApproach) contextLabel = 'GAP FAR SCAN';
    else if (ladderHere) contextLabel = 'STEP / LADDER';
    else if (isStuckHere) contextLabel = 'STALL RECOVERY';

    var fArray = [
      isFlatClear,      // f0
      pitTakeoffNow,    // f1
      pitApproach,      // f2
      spikeTakeoffNow,  // f3
      ladderHere,       // f4
      ghostMed,         // f5
      ghostClose,       // f6
      isStuckHere       // f7
    ];

    return {
      fArray: fArray,
      zKey: fArray.join(''),
      contextLabel: contextLabel,
      pCol: pCol,
      pRow: pRow,
