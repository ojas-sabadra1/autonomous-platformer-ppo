      for (var ci = 0; ci < chests.length; ci++) {
        var ch = chests[ci];
        if (!ch.opened && Math.hypot((player.x + 9) - (ch.x + 14), (player.y + 12) - (ch.y + 14)) < 32) {
          ch.opened = true; ep.coinReward += REWARD_CFG.coinReward; ep.stepRewardAccumulator += REWARD_CFG.coinReward;
          ep.stagnantFrames = 0;
