    };
  }

  function stepRoboticsAgent() {
    var ctxData = extractMultiModalPerception();
    var features = ctxData.fArray;
    var zKey = ctxData.zKey;
    var pCol = ctxData.pCol;
    var pRow = ctxData.pRow;
    var visitsHere = ctxData.visitsHere;
    rlBrain.activeContextText = ctxData.contextLabel;

    var bKey = pCol + ',' + pRow;
    if (ep.framesAlive % 5 === 0) breadcrumbs[bKey] = (breadcrumbs[bKey] || 0) + 1;

    // 1. HUMAN DEMONSTRATION MODE
    if (!aiEnabled) {
      rlBrain.activeContextText = 'HUMAN TELEOP';
      var hLeft = Boolean(keys['KeyA'] || keys['ArrowLeft']);
      var hRight = Boolean(keys['KeyD'] || keys['ArrowRight']);
      var hUp = Boolean(keys['KeyW'] || keys['ArrowUp']);
      var hDown = Boolean(keys['KeyS'] || keys['ArrowDown']);
      var hJump = Boolean(keys['Space'] || (hUp && !player.onLadder));
      var hInteract = Boolean(keys['KeyE']);
      var hShoot = Boolean(mouse.down || keys['KeyJ'] || keys['KeyZ']);

      var humanAct = null;
      if (hRight && hJump) humanAct = 3;
      else if (hUp && hRight) humanAct = 4;
      else if (hJump) humanAct = 2;
      else if (hShoot) humanAct = 5;
      else if (hRight) humanAct = 1;
      else if (hLeft) humanAct = 0;

      if (humanAct !== null && (player.onGround || player.onLadder)) {
        ensureLatentCluster(zKey);
        rlBrain.latentCounts[zKey][humanAct] += 3;
        recordAndStepUpdate(features, zKey, humanAct, 0.5, +950, features, zKey);
      }

      return { left: hLeft, right: hRight, up: hUp, down: hDown, jump: hJump, interact: hInteract, shoot: hShoot };
    }

    // 2. AUTONOMOUS ROBOTICS CONTROLLER (WIN-STAY, LOSE-SHIFT SATISFICING + PPO-GAE)
    if (player.onGround || player.onLadder) {
      if (ep.lastDecisionFeatures !== null && ep.lastDecisionKey !== null && ep.lastDecisionAction !== null) {
        var dx = player.x - ep.lastDecisionX;
        var stallPenalty = (Math.abs(dx) < 0.4 && visitsHere >= 3) ? -(visitsHere * 240) : 0;
        if (stallPenalty < 0) ep.loopPenalty += Math.abs(stallPenalty);

        var velTrackingReward = (dx * 100) + ep.stepRewardAccumulator + stallPenalty;
        recordAndStepUpdate(
          ep.lastDecisionFeatures,
          ep.lastDecisionKey,
          ep.lastDecisionAction,
          ep.lastDecisionProb,
          velTrackingReward,
          features,
          zKey
        );
      }

      ep.stepRewardAccumulator = 0;
      ep.lastDecisionX = player.x;

      ensureLatentCluster(zKey);
      var distObj = evaluateActorDistribution(features, zKey);
      rlBrain.lastProbs = distObj.probs;
      rlBrain.lastAdv = rlBrain.latentActionAdv[zKey];
      rlBrain.lastCriticVal = evaluateCriticV(features, zKey);

      var counts = rlBrain.latentCounts[zKey];
      var advArr = rlBrain.latentActionAdv[zKey];
      var chosenAct = 1;
      var immediateDanger = (features[1] === 1 || features[3] === 1 || features[6] === 1);

      if (ep.macroTimer > 0 && !immediateDanger) {
        ep.macroTimer--;
        chosenAct = ep.macroAction;
      } else {
        ep.macroTimer = 0;

        // WIN-STAY, LOSE-SHIFT SATISFICING RULE:
        // Check if ANY action in this sensory state has already proven to be a clear winner (Adv > +1.5)!
        // If so, DO NOT force suicidal probing of untried buttons—lock onto the winning action 100%!
        var hasProvenWinner = false;
        var bestProvenAct = 0;
        var bestProvenAdv = -Infinity;
        for (var w = 0; w < NUM_ACTIONS; w++) {
          if (counts[w] > 0 && advArr[w] > 1.5 && advArr[w] > bestProvenAdv) {
            hasProvenWinner = true;
            bestProvenAdv = advArr[w];
            bestProvenAct = w;
          }
        }

        if (hasProvenWinner && visitsHere < 3) {
          chosenAct = bestProvenAct;
        } else {
          // Otherwise, probe untried actions that haven't failed yet!
          var bestScore = -Infinity;
          for (var a = 0; a < NUM_ACTIONS; a++) {
            var nA = counts[a];
            var probeBonus = 0;
            if (nA === 0) {
              probeBonus = 12.0 + Math.random() * 0.5;
            } else if (visitsHere >= 3) {
              probeBonus = (a === ep.currentAction) ? -35.0 : (10.0 / Math.sqrt(nA));
            }

            var combinedScore = distObj.logits[a] + probeBonus;
            if (combinedScore > bestScore) {
              bestScore = combinedScore;
              chosenAct = a;
            }
          }
        }

        counts[chosenAct]++;

        if (visitsHere >= 3 && chosenAct !== ep.currentAction) {
          ep.macroAction = chosenAct;
          ep.macroTimer = 10;
        }
      }

      ep.lastDecisionFeatures = features;
      ep.lastDecisionKey = zKey;
      ep.lastDecisionAction = chosenAct;
      ep.lastDecisionProb = distObj.probs[chosenAct];
      ep.currentAction = chosenAct;
    } else {
      if (ep.currentAction === 2 || ep.currentAction === 3) ep.currentAction = 3;
    }

    var act = { left: false, right: false, up: false, down: false, jump: false, interact: false, shoot: false };
    switch (ep.currentAction) {
      case 0: act.left = true; break;
      case 1: act.right = true; break;
      case 2: act.jump = true; break;
      case 3: act.right = true; act.jump = true; break;
      case 4: act.up = true; act.right = true; act.interact = true; break;
      case 5: act.right = true; act.shoot = true; break;
    }

    return act;
  }

  // ===========================================================================
  // 7. PHYSICS LOOP
  // ===========================================================================
  function fireSpell(targetX, targetY) {
    if (player.castCd > 0 || player.mana < 5) return;
    player.mana -= 5;
    player.castCd = 14;

    ep.bulletsFired++;
    ep.bulletPenalty += REWARD_CFG.bulletCost;
    ep.stepRewardAccumulator -= REWARD_CFG.bulletCost;
    playTone(540, 'triangle', 0.1, 180, 0.05);

    var ox = player.x + player.w / 2;
    var oy = player.y + player.h / 2 - 2;
    var ang = Math.atan2(targetY - oy, targetX - ox);
    player.aimAngle = ang;
    player.facing = Math.cos(ang) >= 0 ? 1 : -1;

    var spd = player.weapon === 'crimson' ? 9.2 : 8.2;
    spells.push({ x: ox + Math.cos(ang) * 10, y: oy + Math.sin(ang) * 10, vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd, dmg: player.weapon === 'crimson' ? 2 : 1, type: player.weapon === 'crimson' ? 'flame' : 'arcane', life: 50 });
  }

  function applyHeavyHeartLoss(heartsLostCount) {
    player.hp -= heartsLostCount;
    ep.heartsLost += heartsLostCount;
    var pen = heartsLostCount * REWARD_CFG.heartLostPenalty;
    ep.damagePenalty += pen;
    ep.stepRewardAccumulator -= pen;
    playTone(120, 'sawtooth', 0.18, 40, 0.12);
  }

  function stepPhysics() {
    if (isConcluding) return;
    ep.framesAlive++;
    actualStepsThisSec++;

    if (player.x + 1400 > worldCols * TILE) appendCurriculumSector();
    if (player.mana < player.maxMana) player.mana = Math.min(player.maxMana, player.mana + 0.35);
    if (player.invuln > 0) player.invuln--;
    if (player.castCd > 0) player.castCd--;

    var prevX = player.x;
    var aiAct = stepRoboticsAgent();
    var inLeft = aiAct.left, inRight = aiAct.right, inUp = aiAct.up, inDown = aiAct.down, inJump = aiAct.jump, inInteract = aiAct.interact;

    if (aiAct.shoot) {
      var pCx = player.x + player.w / 2, pCy = player.y + player.h / 2;
      var aimX = aiEnabled ? (pCx + Math.cos(ep.aimAngle) * 120) : mouse.worldX;
      var aimY = aiEnabled ? (pCy + Math.sin(ep.aimAngle) * 120) : mouse.worldY;
      fireSpell(aimX, aimY);
    }

    var centerC = Math.floor((player.x + player.w / 2) / TILE);
    var bodyR = Math.floor((player.y + player.h / 2) / TILE);
    var feetR = Math.floor((player.y + player.h - 1) / TILE);
    var belowFeetR = Math.floor((player.y + player.h + 4) / TILE);

    var inLad = (getTile(centerC, bodyR) === '3' || getTile(centerC, feetR) === '3');
    var onLadTop = isTopOfLadder(centerC, belowFeetR);

    if (inLad && (inUp || inDown)) {
      player.onLadder = true; player.x += ((centerC * TILE + (TILE - player.w) / 2) - player.x) * 0.25;
    } else if (onLadTop && inDown) {
      player.onLadder = true; player.onGround = false; player.y += 5;
    }
    if (!inLad && !onLadTop) player.onLadder = false;

    var mx = 0;
    if (inLeft) { mx -= 1; player.facing = -1; }
    if (inRight) { mx += 1; player.facing = 1; }
    player.vx = mx * player.speed;

    if (player.onGround) player.coyote = 8;
    else if (player.coyote > 0) player.coyote--;

    if (inJump && !player.onLadder) player.jumpBuf = 6;
    else if (player.jumpBuf > 0) player.jumpBuf--;

    if (player.onLadder) {
      player.vy = 0;
      if (inUp) player.vy = -player.speed * 0.92;
      if (inDown) player.vy = player.speed * 0.92;
      var topCheckR = Math.floor((player.y + player.h - 2) / TILE);
      if (inUp && getTile(centerC, topCheckR) !== '3' && isTopOfLadder(centerC, topCheckR + 1)) {
        player.y = (topCheckR + 1) * TILE - player.h; player.vy = 0; player.onLadder = false; player.onGround = true;
      }
    } else {
      player.vy += 0.36;
      if (player.vy > 8.8) player.vy = 8.8;
      if (player.jumpBuf > 0 && player.coyote > 0) {
        player.vy = -player.jumpPower; player.onGround = false; player.coyote = 0; player.jumpBuf = 0;
      }
    }

    player.x += player.vx;
    var lC = Math.floor(player.x / TILE);
    var rC = Math.floor((player.x + player.w - 0.01) / TILE);
    var tR = Math.floor((player.y + 2) / TILE);
    var bR = Math.floor((player.y + player.h - 2) / TILE);

    if (player.vx > 0) {
      if (isSolidWall(rC, tR) || isSolidWall(rC, bR)) { player.x = rC * TILE - player.w - 0.05; player.vx = 0; }
    } else if (player.vx < 0) {
      if (isSolidWall(lC, tR) || isSolidWall(lC, bR)) { player.x = (lC + 1) * TILE + 0.05; player.vx = 0; }
    }

    var prevBottom = player.y + player.h;
    player.y += player.vy;
    lC = Math.floor((player.x + 2) / TILE); rC = Math.floor((player.x + player.w - 2) / TILE);
    tR = Math.floor(player.y / TILE); bR = Math.floor((player.y + player.h) / TILE);

    player.onGround = false;
    if (player.vy >= 0 && !player.onLadder) {
      var solidFl = isSolidWall(lC, bR) || isSolidWall(rC, bR);
      var ladFl = !inDown && (isTopOfLadder(lC, bR) || isTopOfLadder(rC, bR)) && (prevBottom <= bR * TILE + 6);
      if (solidFl || ladFl) {
        player.y = bR * TILE - player.h; player.vy = 0; player.onGround = true;

        var tB1 = getTile(centerC - 1, bR - 1), tBU1 = getTile(centerC - 1, bR);
        var tB2 = getTile(centerC - 2, bR - 1), tBU2 = getTile(centerC - 2, bR);
        var clearedHazard = (tB1 === '4' || tBU1 === 'L' || tBU1 === '.' || tB2 === '4' || tBU2 === 'L' || tBU2 === '.');
        if (clearedHazard && centerC > ep.lastClearedCol) {
          ep.lastClearedCol = centerC; ep.hazardsCleared++; ep.evadeReward += REWARD_CFG.evadeReward;
          ep.stepRewardAccumulator += REWARD_CFG.evadeReward;
          ep.stagnantFrames = 0;
          playTone(880, 'triangle', 0.12, 1320, 0.06);
        }
      }
    } else if (player.vy < 0 && !player.onLadder) {
      if (isSolidWall(lC, tR) || isSolidWall(rC, tR)) { player.y = (tR + 1) * TILE; player.vy = 0; }
    }

    if (player.x > ep.maxPxReached) {
      var deltaMeters = (player.x - ep.maxPxReached) / 12;
      ep.maxPxReached = player.x;
      var fwdGain = deltaMeters * REWARD_CFG.xDistPerMeter * (1 + getDistanceMeters() * 0.02);
      ep.distReward += fwdGain; ep.stepRewardAccumulator += fwdGain;
      ep.stagnantFrames = 0;
      if (getDistanceMeters() > rlBrain.maxDistMeters) rlBrain.maxDistMeters = getDistanceMeters();
    } else if (player.x < prevX - 0.1) {
      var backMeters = (prevX - player.x) / 12;
      var backCost = backMeters * REWARD_CFG.backPenaltyPerMeter;
      ep.distReward -= backCost;
      ep.stepRewardAccumulator -= backCost * 1.5;
    } else if (aiEnabled) {
      ep.stagnantFrames++;
      if (ep.stagnantFrames > 420) {
        concludeAttempt("Stall / Loop", true);
        return;
      }
    }

    var liveScoreBeforeDeath = getNetReward();
    if (liveScoreBeforeDeath > ep.peakNetScoreThisRun) {
      ep.peakNetScoreThisRun = liveScoreBeforeDeath;
    }
    if (rlBrain.bestReward === null || liveScoreBeforeDeath > rlBrain.bestReward) {
      rlBrain.bestReward = liveScoreBeforeDeath;
    }

    var fC1 = Math.floor((player.x + 4) / TILE), fC2 = Math.floor((player.x + player.w - 4) / TILE), fR = Math.floor((player.y + player.h - 2) / TILE);
    var hz1 = getTile(fC1, fR), hz2 = getTile(fC2, fR);
    if (hz1 === '4' || hz2 === '4') {
      if (player.invuln === 0) {
        applyHeavyHeartLoss(1);
        player.invuln = 35; player.vy = -5.8;
        if (player.hp <= 0) { concludeAttempt("Spikes", true); return; }
      }
    } else if (hz1 === 'L' || hz2 === 'L') {
      if (player.invuln === 0) {
        applyHeavyHeartLoss(2);
        player.invuln = 35; player.vy = -6.8;
        if (player.hp <= 0) { concludeAttempt("Lava", true); return; }
      }
    }

    for (var i = spells.length - 1; i >= 0; i--) {
      var s = spells[i]; s.x += s.vx; s.y += s.vy; s.life--;
      var sc = Math.floor(s.x / TILE), sr = Math.floor(s.y / TILE);
      if (isSolidWall(sc, sr)) { spells.splice(i, 1); continue; }
      for (var g = 0; g < ghosts.length; g++) {
        var gh = ghosts[g];
        if (gh.hp > 0 && Math.hypot(s.x - (gh.x + 14), s.y - (gh.y + 14)) < 19) {
          gh.hp -= s.dmg;
          ep.bulletPenalty = Math.max(0, ep.bulletPenalty - REWARD_CFG.bulletCost);
          ep.stepRewardAccumulator += REWARD_CFG.bulletCost * 1.5;
          ep.stagnantFrames = 0;
          s.life = 0;
          if (gh.hp <= 0) {
            ep.ghostKills++;
            ep.ghostReward += REWARD_CFG.ghostKill;
            ep.stepRewardAccumulator += REWARD_CFG.ghostKill;
            playTone(680, 'sine', 0.12, 1100, 0.06);
          }
          break;
        }
      }
      if (s.life <= 0) spells.splice(i, 1);
    }

    for (var gi = 0; gi < ghosts.length; gi++) {
      var ghObj = ghosts[gi]; if (ghObj.hp <= 0) continue;
      ghObj.bob += 0.06;
      var dist = Math.hypot((player.x + 9) - (ghObj.x + 14), (player.y + 12) - (ghObj.y + 14));
      if (dist < 135) {
        var ang = Math.atan2((player.y + 12) - (ghObj.y + 14), (player.x + 9) - (ghObj.x + 14));
        ghObj.x += Math.cos(ang) * 1.15; ghObj.y += Math.sin(ang) * 0.6; ghObj.dir = Math.cos(ang) >= 0 ? 1 : -1;
      } else { ghObj.x += ghObj.vx * ghObj.dir; if (ghObj.x > ghObj.maxX) ghObj.dir = -1; if (ghObj.x < ghObj.minX) ghObj.dir = 1; }
