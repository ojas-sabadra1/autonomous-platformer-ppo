          ctx.strokeStyle = '#181524'; ctx.strokeRect(dx + 0.5, dy + 0.5, TILE - 1, TILE - 1);
        } else if (t === '2') {
          ctx.fillStyle = '#3e332e'; ctx.fillRect(dx, dy, TILE, TILE);
          ctx.fillStyle = '#1d7855'; ctx.fillRect(dx, dy, TILE, 7);
        } else if (t === '3') {
          if (isTopOfLadder(c, r)) { ctx.fillStyle = '#266347'; ctx.fillRect(dx, dy, TILE, 5); }
          ctx.fillStyle = '#704826'; ctx.fillRect(dx + 5, dy, 3, TILE); ctx.fillRect(dx + TILE - 8, dy, 3, TILE);
          ctx.fillStyle = '#ad7645'; for (var y = 4; y < TILE; y += 7) ctx.fillRect(dx + 5, dy + y, TILE - 10, 3);
        } else if (t === '4') {
          for (var s = 0; s < 3; s++) { var sx = dx + 2 + s * 8; ctx.fillStyle = '#e63946'; ctx.beginPath(); ctx.moveTo(sx, dy + TILE); ctx.lineTo(sx + 4, dy + 10); ctx.lineTo(sx + 8, dy + TILE); ctx.fill(); }
        } else if (t === 'L') {
          var wave = Math.sin(Date.now() * 0.005 + c) * 2.5; ctx.fillStyle = '#e63900'; ctx.fillRect(dx, dy + 5 + wave, TILE, TILE - 5 - wave); ctx.fillStyle = '#ffcc00'; ctx.fillRect(dx, dy + 3 + wave, TILE, 4);
        } else if (t === '5') {
