        }
      }
    }

    for (var cIdx = 0; cIdx < coins.length; cIdx++) {
      var cObj = coins[cIdx];
      if (!cObj.collected && Math.hypot((player.x + 9) - (cObj.x + 8), (player.y + 12) - (cObj.y + 8)) < 20) {
        cObj.collected = true; ep.coinsCollected++; ep.coinReward += REWARD_CFG.coinReward; ep.stepRewardAccumulator += REWARD_CFG.coinReward;
        ep.stagnantFrames = 0;
